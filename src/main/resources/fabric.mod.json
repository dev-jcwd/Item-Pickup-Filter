{
  "schemaVersion": 1,
  "id": "ipf",
  "version": "${version}",
  "name": "Item Pickup Filter",
  "description": "Client-side item pickup filter.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ipf.IPFClient"
    ],
    "modmenu": [
      "com.ipf.IPFModMenu"
    ]
  },
  "mixins": [
    "ipf.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "${mc_range}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
